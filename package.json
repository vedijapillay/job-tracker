{
  "name": "job-tracker",
  "version": "1.0.0",
  "description": "Track your job applications locally, with optional Gmail scanning that detects applications, interviews, offers and rejections. Your data stays on your machine.",
  "scripts": {
    "setup": "npm install && npm install --prefix client && npm run build --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/server.js",
    "demo": "node server/demo.js",
    "dev": "node --watch server/server.js",
    "dev:client": "npm run dev --prefix client",
    "test": "node --test"
  },
  "keywords": [
    "job-tracker",
    "job-search",
    "gmail",
    "local-first",
    "privacy"
  ],
  "author": "Vedija Pillay",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vedijapillay/job-tracker.git"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "fsevents@2.3.3": false
  }
}

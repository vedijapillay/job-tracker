# Everything in this file is optional. Copy it to ".env" to use it:  cp .env.example .env
# Job Tracker works without a .env file at all.

# --- Gmail scanning ---------------------------------------------------------
# Your own Google OAuth credentials. You can also enter these inside the app
# (Scan Gmail -> Gmail setup); credentials saved in the app take precedence.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Basics -----------------------------------------------------------------
# Port the app listens on (default 3000). If you change it, add the matching
# redirect address in Google Cloud: http://localhost:<port>/api/gmail/auth/callback
# PORT=3000

# Where your jobs are stored (default: jobs.db in the project folder).
# JOBS_DB_PATH=/path/to/jobs.db

# --- Development / advanced -------------------------------------------------
# When running the web app separately with "npm run dev:client", send the Google
# sign-in back to its address:
# FRONTEND_URL=http://localhost:5173

# Override the redirect address sent to Google (default is built from PORT).
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/auth/callback

# The server only listens on this computer (127.0.0.1). To reach it another way,
# for example from a container, set HOST and list the host names it should accept.
# HOST=127.0.0.1
# ALLOWED_HOSTS=myhost:3000
# ALLOWED_ORIGINS=http://myhost:3000
